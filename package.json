{
  "name": "commitflow",
  "displayName": "CommitFlow - Git Graph, Visual History & Developer Hub",
  "description": "High-performance interactive Git commit & branch graph visualizer, real-time live blame with author avatars, visual file history, PR launchpad, worktrees & multi-WIP, cloud patches, and adaptive layout modes for VS Code.",
  "version": "0.4.5",
  "publisher": "Ignaciobrenas",
  "icon": "resources/commitflow-logo-color.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "git",
    "graph",
    "blame",
    "branch",
    "commit",
    "stash",
    "worktrees",
    "pull-requests",
    "cloud-patches",
    "file-history",
    "author",
    "avatar",
    "diff",
    "productivity",
    "gitlens"
  ],
  "homepage": "https://github.com/Ignaciobrenas/CommitFlow#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ignaciobrenas/CommitFlow"
  },
  "bugs": {
    "url": "https://github.com/Ignaciobrenas/CommitFlow/issues"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "bin": {
    "commitflow-mcp": "./bin/commitflow-mcp.js"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "commitflow.openGraph",
        "title": "%commitflow.command.openGraph%",
        "category": "CommitFlow",
        "icon": "$(git-branch)"
      },
      {
        "command": "commitflow.toggleInlineBlame",
        "title": "%commitflow.command.toggleInlineBlame%",
        "category": "CommitFlow"
      },
      {
        "command": "commitflow.showLineCommit",
        "title": "%commitflow.command.showLineCommit%",
        "category": "CommitFlow",
        "icon": "$(git-commit)"
      },
      {
        "command": "commitflow.openLineDiff",
        "title": "%commitflow.command.openLineDiff%",
        "category": "CommitFlow",
        "icon": "$(git-diff)"
      },
      {
        "command": "commitflow.openOnGitHub",
        "title": "%commitflow.command.openOnGitHub%",
        "category": "CommitFlow",
        "icon": "$(link-external)"
      },
      {
        "command": "commitflow.showPersonalStats",
        "title": "%commitflow.command.showPersonalStats%",
        "category": "CommitFlow",
        "icon": "$(graph-line)"
      },
      {
        "command": "commitflow.pullCurrentBranch",
        "title": "%commitflow.command.pullCurrentBranch%",
        "category": "CommitFlow",
        "icon": "$(cloud-download)"
      },
      {
        "command": "commitflow.rebaseCurrentBranch",
        "title": "%commitflow.command.rebaseCurrentBranch%",
        "category": "CommitFlow",
        "icon": "$(git-pull-request-go-to-changes)"
      },
      {
        "command": "commitflow.mergeCurrentBranch",
        "title": "%commitflow.command.mergeCurrentBranch%",
        "category": "CommitFlow",
        "icon": "$(git-merge)"
      },
      {
        "command": "commitflow.stashSave",
        "title": "%commitflow.command.stashSave%",
        "category": "CommitFlow",
        "icon": "$(archive)"
      },
      {
        "command": "commitflow.stashPop",
        "title": "%commitflow.command.stashPop%",
        "category": "CommitFlow",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "commitflow.fetchRemotes",
        "title": "%commitflow.command.fetchRemotes%",
        "category": "CommitFlow",
        "icon": "$(sync)"
      },
      {
        "command": "commitflow.openSettings",
        "title": "%commitflow.command.openSettings%",
        "category": "CommitFlow",
        "icon": "$(settings-gear)"
      },
      {
        "command": "commitflow.refreshGraph",
        "title": "%commitflow.command.refreshGraph%",
        "category": "CommitFlow",
        "icon": "$(refresh)"
      },
      {
        "command": "commitflow.showFileHistory",
        "title": "%commitflow.command.showFileHistory%",
        "category": "CommitFlow",
        "icon": "$(history)"
      },
      {
        "command": "commitflow.openWorktrees",
        "title": "%commitflow.command.openWorktrees%",
        "category": "CommitFlow",
        "icon": "$(repo-forked)"
      },
      {
        "command": "commitflow.openPrLaunchpad",
        "title": "%commitflow.command.openPrLaunchpad%",
        "category": "CommitFlow",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "commitflow.createCloudPatch",
        "title": "%commitflow.command.createCloudPatch%",
        "category": "CommitFlow",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "commitflow.openIssues",
        "title": "%commitflow.command.openIssues%",
        "category": "CommitFlow",
        "icon": "$(issues)"
      },
      {
        "command": "commitflow.openInFork",
        "title": "%commitflow.command.openInFork%",
        "category": "CommitFlow",
        "icon": "$(link-external)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "commitflow-sidebar",
          "title": "CommitFlow",
          "icon": "resources/commitflow-isotipo-white.svg"
        }
      ],
      "panel": [
        {
          "id": "commitflow-bottom",
          "title": "CommitFlow",
          "icon": "resources/commitflow-isotipo-white.svg"
        }
      ]
    },
    "views": {
      "commitflow-sidebar": [
        {
          "type": "webview",
          "id": "commitflow.mainView",
          "name": "CommitFlow Hub",
          "icon": "resources/commitflow-isotipo-white.svg"
        }
      ]
    },
    "configuration": {
      "title": "%commitflow.config.title%",
      "properties": {
        "commitflow.language": {
          "type": "string",
          "enum": [
            "auto",
            "es",
            "en"
          ],
          "default": "auto",
          "description": "%commitflow.config.language%"
        },
        "commitflow.inlineBlame.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%commitflow.config.inlineBlame.enabled%"
        },
        "commitflow.inlineBlame.delay": {
          "type": "number",
          "default": 120,
          "description": "%commitflow.config.inlineBlame.delay%"
        },
        "commitflow.avatars.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%commitflow.config.avatars.enabled%"
        },
        "commitflow.avatars.service": {
          "type": "string",
          "enum": [
            "gravatar",
            "github",
            "initials"
          ],
          "default": "gravatar",
          "description": "%commitflow.config.avatars.service%"
        },
        "commitflow.graph.pageSize": {
          "type": "number",
          "default": 300,
          "description": "%commitflow.config.graph.pageSize%"
        },
        "commitflow.graph.density": {
          "type": "string",
          "enum": [
            "compact",
            "comfortable",
            "spacious"
          ],
          "default": "comfortable",
          "description": "%commitflow.config.graph.density%"
        },
        "commitflow.graph.theme": {
          "type": "string",
          "enum": [
            "auto",
            "dark",
            "light",
            "cyberpunk",
            "dracula",
            "github",
            "neon-pink",
            "neon-green",
            "neon-blue"
          ],
          "enumDescriptions": [
            "Automatic (follows VS Code theme)",
            "Cyber Dark Mode",
            "Professional Light Mode",
            "Cyberpunk (Neon Yellow & Purple)",
            "Dracula Official Spec",
            "GitHub Dark Premier",
            "Neon Pink (Synthwave)",
            "Neon Green (Matrix Terminal)",
            "Neon Blue (Tron Electric)"
          ],
          "default": "auto",
          "description": "%commitflow.config.graph.theme%"
        },
        "commitflow.graph.layoutMode": {
          "type": "string",
          "enum": [
            "auto",
            "bottom",
            "left",
            "right"
          ],
          "default": "auto",
          "description": "%commitflow.config.graph.layoutMode%"
        },
        "commitflow.graph.animations": {
          "type": "boolean",
          "default": true,
          "description": "%commitflow.config.graph.animations%"
        },
        "commitflow.sync.autoFetch": {
          "type": "boolean",
          "default": true,
          "description": "%commitflow.config.sync.autoFetch%"
        },
        "commitflow.sync.fetchIntervalMinutes": {
          "type": "number",
          "default": 5,
          "description": "%commitflow.config.sync.fetchIntervalMinutes%"
        },
        "commitflow.sync.notifyOnBranchMerge": {
          "type": "boolean",
          "default": true,
          "description": "%commitflow.config.sync.notifyOnBranchMerge%"
        },
        "commitflow.sync.askBeforePull": {
          "type": "boolean",
          "default": true,
          "description": "%commitflow.config.sync.askBeforePull%"
        },
        "commitflow.remotes.forgejoInstances": {
          "type": "array",
          "default": [],
          "description": "Lista de dominios o IPs de tus servidores Forgejo/Gitea self-hosted (ej. ['git.midominio.com', '192.168.1.100:3000']). Si usas SSH en un puerto distinto al HTTP, mapea el host SSH al endpoint API."
        },
        "commitflow.ssh.configPath": {
          "type": "string",
          "default": "~/.ssh/config",
          "description": "Ruta al archivo de configuración SSH para resolver alias de hosts y claves privadas."
        },
        "commitflow.issues.defaultFilter": {
          "type": "string",
          "enum": ["assignedToMe", "linkedToBranch", "createdByMe", "allOpen"],
          "default": "assignedToMe",
          "description": "Filtro persistente por defecto al abrir la pestaña de Issues."
        },
        "commitflow.issues.branchNamingPattern": {
          "type": "string",
          "default": "feat/{id}-{slug}",
          "description": "Plantilla automática al crear una rama o worktree desde un Issue."
        },
        "commitflow.integrations.enableForkButton": {
          "type": "boolean",
          "default": true,
          "description": "Mostrar acción rápida para abrir el repositorio o worktree actual en el cliente Git Fork."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "commitflow.openGraph",
          "group": "navigation",
          "when": "!isInEmbeddedEditor"
        },
        {
          "command": "commitflow.showFileHistory",
          "group": "navigation",
          "when": "!isInEmbeddedEditor"
        }
      ],
      "editor/context": [
        {
          "command": "commitflow.showLineCommit",
          "group": "1_modification",
          "when": "editorTextFocus"
        },
        {
          "command": "commitflow.showFileHistory",
          "group": "1_modification",
          "when": "editorTextFocus"
        }
      ],
      "view/title": [
        {
          "command": "commitflow.refreshGraph",
          "when": "view == commitflow.mainView || view == commitflow.graphView",
          "group": "navigation"
        },
        {
          "command": "commitflow.openGraph",
          "when": "view == commitflow.mainView || view == commitflow.graphView",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "commitflow.openGraph",
        "key": "ctrl+alt+b",
        "mac": "cmd+alt+b"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build": "node esbuild.js --production",
    "dev": "node esbuild.js --watch",
    "test": "node -e \"require('esbuild').buildSync({entryPoints:['test/runTests.ts'],outfile:'dist/test.js',bundle:true,platform:'node',alias:{'vscode':'./test/vscodeMock.ts'}}); require('./dist/test.js')\"",
    "test:live": "node -e \"require('esbuild').buildSync({entryPoints:['test/verifyLiveIntegration.ts'],outfile:'dist/verifyLive.js',bundle:true,platform:'node',alias:{'vscode':'./test/vscodeMock.ts'}}); require('./dist/verifyLive.js')\"",
    "mcp": "node dist/mcp.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.46-24"
  }
}

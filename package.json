{
  "name": "branchify",
  "displayName": "Branchify - Git Graph & Deep Live Blame",
  "description": "High-performance interactive Git commit & branch graph visualizer, real-time deep inline blame with author avatars, and developer productivity tools.",
  "version": "0.2.0",
  "publisher": "Ignaciobrenas",
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "git",
    "graph",
    "blame",
    "branch",
    "commit",
    "author",
    "avatar",
    "history",
    "diff",
    "productivity"
  ],
  "homepage": "https://github.com/Ignaciobrenas/branchify#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ignaciobrenas/branchify"
  },
  "bugs": {
    "url": "https://github.com/Ignaciobrenas/branchify/issues"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "bin": {
    "branchify-mcp": "./bin/branchify-mcp.js"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "branchify.openGraph",
        "title": "%branchify.command.openGraph%",
        "category": "Branchify",
        "icon": "$(git-branch)"
      },
      {
        "command": "branchify.toggleInlineBlame",
        "title": "%branchify.command.toggleInlineBlame%",
        "category": "Branchify"
      },
      {
        "command": "branchify.showLineCommit",
        "title": "%branchify.command.showLineCommit%",
        "category": "Branchify",
        "icon": "$(git-commit)"
      },
      {
        "command": "branchify.openLineDiff",
        "title": "%branchify.command.openLineDiff%",
        "category": "Branchify",
        "icon": "$(git-diff)"
      },
      {
        "command": "branchify.openOnGitHub",
        "title": "%branchify.command.openOnGitHub%",
        "category": "Branchify",
        "icon": "$(link-external)"
      },
      {
        "command": "branchify.showPersonalStats",
        "title": "%branchify.command.showPersonalStats%",
        "category": "Branchify",
        "icon": "$(graph-line)"
      },
      {
        "command": "branchify.pullCurrentBranch",
        "title": "%branchify.command.pullCurrentBranch%",
        "category": "Branchify",
        "icon": "$(cloud-download)"
      },
      {
        "command": "branchify.fetchRemotes",
        "title": "%branchify.command.fetchRemotes%",
        "category": "Branchify",
        "icon": "$(sync)"
      },
      {
        "command": "branchify.openSettings",
        "title": "%branchify.command.openSettings%",
        "category": "Branchify",
        "icon": "$(settings-gear)"
      },
      {
        "command": "branchify.refreshGraph",
        "title": "%branchify.command.refreshGraph%",
        "category": "Branchify",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "branchify-explorer",
          "title": "Branchify",
          "icon": "resources/icon.png"
        }
      ]
    },
    "views": {
      "branchify-explorer": [
        {
          "type": "webview",
          "id": "branchify.graphView",
          "name": "%branchify.view.graphView%"
        }
      ]
    },
    "configuration": {
      "title": "%branchify.config.title%",
      "properties": {
        "branchify.language": {
          "type": "string",
          "enum": [
            "auto",
            "es",
            "en"
          ],
          "default": "auto",
          "description": "%branchify.config.language%"
        },
        "branchify.inlineBlame.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%branchify.config.inlineBlame.enabled%"
        },
        "branchify.inlineBlame.delay": {
          "type": "number",
          "default": 120,
          "description": "%branchify.config.inlineBlame.delay%"
        },
        "branchify.avatars.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%branchify.config.avatars.enabled%"
        },
        "branchify.avatars.service": {
          "type": "string",
          "enum": [
            "gravatar",
            "github",
            "initials"
          ],
          "default": "gravatar",
          "description": "%branchify.config.avatars.service%"
        },
        "branchify.graph.pageSize": {
          "type": "number",
          "default": 300,
          "description": "%branchify.config.graph.pageSize%"
        },
        "branchify.graph.density": {
          "type": "string",
          "enum": [
            "compact",
            "comfortable",
            "spacious"
          ],
          "default": "comfortable",
          "description": "%branchify.config.graph.density%"
        },
        "branchify.graph.theme": {
          "type": "string",
          "enum": [
            "auto",
            "dark",
            "light"
          ],
          "default": "auto",
          "description": "%branchify.config.graph.theme%"
        },
        "branchify.graph.animations": {
          "type": "boolean",
          "default": true,
          "description": "%branchify.config.graph.animations%"
        },
        "branchify.sync.autoFetch": {
          "type": "boolean",
          "default": true,
          "description": "%branchify.config.sync.autoFetch%"
        },
        "branchify.sync.fetchIntervalMinutes": {
          "type": "number",
          "default": 5,
          "description": "%branchify.config.sync.fetchIntervalMinutes%"
        },
        "branchify.sync.notifyOnBranchMerge": {
          "type": "boolean",
          "default": true,
          "description": "%branchify.config.sync.notifyOnBranchMerge%"
        },
        "branchify.sync.askBeforePull": {
          "type": "boolean",
          "default": true,
          "description": "%branchify.config.sync.askBeforePull%"
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "branchify.showLineCommit",
          "group": "1_modification",
          "when": "editorTextFocus"
        }
      ],
      "view/title": [
        {
          "command": "branchify.refreshGraph",
          "when": "view == branchify.graphView",
          "group": "navigation"
        },
        {
          "command": "branchify.openGraph",
          "when": "view == branchify.graphView",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "branchify.openGraph",
        "key": "ctrl+alt+b",
        "mac": "cmd+alt+b"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build": "node esbuild.js --production",
    "dev": "node esbuild.js --watch",
    "test": "node -e \"require('esbuild').buildSync({entryPoints:['test/runTests.ts'],outfile:'dist/test.js',bundle:true,platform:'node',alias:{'vscode':'./test/vscodeMock.ts'}}); require('./dist/test.js')\"",
    "test:live": "node -e \"require('esbuild').buildSync({entryPoints:['test/verifyLiveIntegration.ts'],outfile:'dist/verifyLive.js',bundle:true,platform:'node',alias:{'vscode':'./test/vscodeMock.ts'}}); require('./dist/verifyLive.js')\"",
    "mcp": "node dist/mcp.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.46-24"
  }
}
